{
  "name": "meatfresh-automation-test",
  "version": "1.0.0",
  "description": "Appium E2E Automation Testing untuk aplikasi Flutter MeatFresh AI",
  "private": true,
  "scripts": {
    "test": "wdio run ./wdio.conf.js",
    "test:home": "wdio run ./wdio.conf.js --spec ./test/specs/home.e2e.js",
    "test:navigation": "wdio run ./wdio.conf.js --spec ./test/specs/navigation.e2e.js",
    "test:capture": "wdio run ./wdio.conf.js --spec ./test/specs/capture.e2e.js",
    "test:history": "wdio run ./wdio.conf.js --spec ./test/specs/history.e2e.js",
    "appium": "appium",
    "driver:install": "appium driver install uiautomator2",
    "driver:list": "appium driver list --installed",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^10.2.0",
    "@wdio/appium-service": "^10.2.0",
    "@wdio/cli": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "allure-commandline": "^2.46.1",
    "appium": "^3.9.1",
    "appium-uiautomator2-driver": "^8.7.3",
    "webdriverio": "^10.2.0"
  }
}
